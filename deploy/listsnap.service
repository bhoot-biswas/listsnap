# ListSnap as a systemd service. Installed by DEPLOY.md to /etc/systemd/system/listsnap.service.
# It runs the live release, /srv/listsnap-current, a link the deploy switches; `next start`
# reads the release's .env.production.local, a link to /etc/listsnap/env.

[Unit]
Description=ListSnap
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=listsnap
Group=listsnap
WorkingDirectory=/srv/listsnap-current
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
# only Nginx on this machine talks to the app
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
# next exits 143 on SIGTERM; a normal stop isn't a failure
SuccessExitStatus=143

# The app user owns the code, so the whole system is read-only to the app: it can't
# change its own code or the deploy files. It writes only its media and reel browser
# (/var/lib/listsnap), /tmp, and Next's cache, which is a folder of its own rather than
# the build's.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/listsnap
CacheDirectory=listsnap
BindPaths=/var/cache/listsnap:/srv/listsnap-current/.next/cache

# The app, its reel browsers and ffmpeg share an 8 GB server with MariaDB and another
# site. The app sits near 300 MB and a reel adds under 900 MB; past MemoryHigh the kernel
# reclaims from this service first, and a runaway render or video is stopped at MemoryMax
# here, instead of the out-of-memory killer picking the database.
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
