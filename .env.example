# ListSnap environment. Copy to .env.local for development; on Hostinger set these in hPanel.
# Only src/server/env.ts reads process.env.

# Public origin of the app. Frozen into the client bundle at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (MariaDB/MySQL, utf8mb4) ────────────────────────────────────────
# Local: `pnpm db:up` starts MariaDB in Docker on port 3307 with these credentials.
DATABASE_URL=mysql://listsnap:listsnap@127.0.0.1:3307/listsnap
# Hostinger caps connections per database user.
# DATABASE_POOL_SIZE=5

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# At least 32 random characters: openssl rand -base64 32. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Defaults to NEXT_PUBLIC_SITE_URL.
# BETTER_AUTH_URL=http://localhost:3000

# Google sign-in. Google Cloud Console → Credentials → OAuth client ID (Web).
# Redirect URIs: http://localhost:3000/api/auth/callback/google and https://<app-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for magic links (Hostinger: smtp.hostinger.com, port 465, full mailbox as user).
# Without SMTP in development, links are printed to the server console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Full sender; defaults to "ListSnap <SMTP_USER>".
MAIL_FROM=

# The one header your proxy sets to the client IP, for rate limits. Use a header the
# proxy overwrites, never one a visitor can send.
# AUTH_IP_HEADER=x-real-ip

# ── Storage and secrets ──────────────────────────────────────────────────────
# Uploaded and generated images. Must be outside the deploy folder on Hostinger.
MEDIA_DIR=./.data/media
# 32 bytes, base64, for store credentials at rest (AES-256-GCM): openssl rand -base64 32
CREDENTIALS_KEY=

# ── AI and outside services ──────────────────────────────────────────────────
# mock | live, per provider. Mock needs no keys and is what tests and CI use.
PROVIDER_MODE_META=mock
PROVIDER_MODE_WOO=mock
PROVIDER_MODE_INSTAGRAM=mock
PROVIDER_MODE_FACEBOOK=mock
# Reels: mock returns a placeholder video; live renders with the pinned HyperFrames CLI
# (needs Chrome, which it downloads on first use, and ffmpeg on the PATH).
PROVIDER_MODE_VIDEO=mock
# Chrome workers per reel render (about 256 MB each)
REEL_WORKERS=2
# Meta Model API key (dev.meta.ai). Needed when PROVIDER_MODE_META=live.
MODEL_API_KEY=
# Optional: slow mock steps down (ms) so the progress UI can be watched.
# MOCK_DELAY_MS=700

# The WooCommerce store demo shops save drafts to (REST keys with read/write).
# `pnpm store:setup` fills these with a local test store on http://localhost:8080.
DEMO_WOO_URL=
DEMO_WOO_KEY=
DEMO_WOO_SECRET=
# Where stores download product images from. Defaults to NEXT_PUBLIC_SITE_URL; the
# local Docker store needs http://host.docker.internal:3000.
# MEDIA_FETCH_BASE_URL=
